		{"id":"file-note-usage","type":"file","x":880,"y":480,"width":400,"height":300,"file":"notes/getting-started.md","subpath":"#Usage"},
		{"id":"link-card","type":"link","x":600,"y":40,"width":400,"height":360,"url":"https://jsoncanvas.org/"}
	],
