{
  "name": "vintrin-markdown-publish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Obsidian-Publish replacement: pure build engine (vault + site config -> static site) with a thin CLI. Quartz 5 is an internal, vendored build tool.",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "publish": "cli/bin/publish.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup-quartz.mjs && node scripts/build-canvas-viewer.mjs",
    "bundle:viewer": "node scripts/build-canvas-viewer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"engine/test/unit/*.test.ts\" \"canvas-plugin/test/unit/*.test.ts\" \"vintrin-explorer/test/unit/*.test.ts\" \"cli/test/unit/*.test.ts\" \"scripts/test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"engine/test/integration/*.test.ts\"",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@quartz-community/utils": "github:quartz-community/utils#e09d8b0bbccb46073b23c00affaf3e40a2c3b0c4",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "json-canvas-viewer": "4.3.2",
    "preact": "^10.28.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.0"
  }
}
